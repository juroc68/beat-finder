PORT=5000
GETSONGBPM_API_KEY=your_getsongbpm_api_key
CHUNK_SIZE=30

# Global API safety net: 5000 requests per 15 minutes by default.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=5000

# Provider-specific quotas. All use the same one-minute window by default.
PROVIDER_RATE_LIMIT_WINDOW_MS=60000
DEEZER_SEARCH_RATE_LIMIT_MAX=120
BPM_SEARCH_RATE_LIMIT_MAX=15
AUDIO_PROXY_RATE_LIMIT_MAX=120
YOUTUBE_SEARCH_RATE_LIMIT_MAX=30
