PORT=5000
GETSONGBPM_API_KEY=your_getsongbpm_api_key
CHUNK_SIZE=30

# High development defaults. Lower these values before exposing the API publicly.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100000

# Provider-specific quotas. All use the same one-minute window by default.
PROVIDER_RATE_LIMIT_WINDOW_MS=60000
DEEZER_SEARCH_RATE_LIMIT_MAX=2000
BPM_SEARCH_RATE_LIMIT_MAX=30
AUDIO_PROXY_RATE_LIMIT_MAX=2000
YOUTUBE_SEARCH_RATE_LIMIT_MAX=300
